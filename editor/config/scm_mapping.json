{
  "format": "SCM",
  "vendor": "SCM Group (XCam/Maestro)",
  "namespaces": {
    "project": "http://schemas.datacontract.org/2004/07/ScmGroup.XCam.MachiningDataModel.ProjectModule",
    "utility": "http://schemas.datacontract.org/2004/07/ScmGroup.XCam.MachiningDataModel.Utility",
    "parametrics": "http://schemas.datacontract.org/2004/07/ScmGroup.XCam.MachiningDataModel.Parametrics",
    "i": "http://www.w3.org/2001/XMLSchema-instance"
  },
  "workpiece": {
    "length": {"xpath": ".//WorkPiece/Length", "type": "float", "default_var": "dx1"},
    "width": {"xpath": ".//WorkPiece/Width", "type": "float", "default_var": "dy1"},
    "thickness": {"xpath": ".//WorkPiece/Depth", "type": "float", "default_var": "dz1"}
  },
  "operations": {
    "drilling": {
      "container_xpath": ".//ManufacturingFeature[i:type='RoundHole']",
      "fields": [
        {"id": "name", "xpath": "@Name", "type": "string", "label": "Имя операции"},
        {"id": "diameter", "xpath": "Diameter", "type": "float", "label": "Диаметр"},
        {"id": "depth", "xpath": "EndDepth", "type": "float", "label": "Глубина"},
        {"id": "geometry_id", "xpath": "GeometryID", "type": "string", "label": "ID геометрии"}
      ]
    },
    "milling": {
      "container_xpath": ".//ManufacturingFeature[i:type='PocketRectangular']",
      "fields": [
        {"id": "name", "xpath": "@Name", "type": "string", "label": "Имя операции"},
        {"id": "depth", "xpath": "EndDepth", "type": "float", "label": "Глубина"},
        {"id": "tool_key", "xpath": "ToolKey", "type": "string", "label": "Ключ инструмента"}
      ]
    }
  },
  "geometries": {
    "container_xpath": ".//Geometries/*",
    "id_attribute": "Key/ID",
    "coordinates": {
      "x": {"xpath": "_x", "type": "float"},
      "y": {"xpath": "_y", "type": "float"},
      "z": {"xpath": "_z", "type": "float"}
    }
  },
  "planes": {
    "container_xpath": ".//Planes/*",
    "id_attribute": "Key/ID",
    "name_field": "Name"
  }
}
